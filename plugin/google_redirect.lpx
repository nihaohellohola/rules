#!name = Google 重定向 (兼容版)
#!desc = 将 Google 的 cn 和 hk 域名自动重定向至 www.google.com，并保留搜索路径。
#!author = Gemini
#!system = iOS,iPadOS,tvOS,macOS
#!tag = 重定向,搜索工具
#!type = normal

[Rewrite]
# 使用旧版正则替换，自动将请求重定向至 com，$3 代表保留的路径参数
^https?:\/\/(www\.)?google\.(cn|com\.hk)\/(.*) https://www.google.com/$3 307

[Mitm]
hostname = www.google.cn, www.google.com.hk, google.cn
